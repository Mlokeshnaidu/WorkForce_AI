# ==============================================================================
# WorkForce AI Pro - Comprehensive Root .gitignore
# Enterprise HR Attrition Prediction & Workforce Intelligence Platform
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python & Virtual Environments
# ------------------------------------------------------------------------------
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
backend/env/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
__pycache__/
*/__pycache__/
**/*.py[cod]
*$py.class
*.so
*.pyd

# Distribution / Packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Unit tests, Coverage & Linting caches
.pytest_cache/
.coverage
.coverage.*
.cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.mypy_cache/
.ruff_cache/
.oxlintrc.json

# ------------------------------------------------------------------------------
# 2. Environment Variables & Credentials
# ------------------------------------------------------------------------------
.env
.env.*
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
*.env
*.env.local

# Preserve example templates
!.env.example
!backend/.env.example
!frontend/.env.example

# ------------------------------------------------------------------------------
# 3. Node.js & Frontend (React / Vite)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
.npm/
.eslintcache

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 4. Database & SQLite Local Dumps
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.sql.gz
*.sql.tar.gz

# ------------------------------------------------------------------------------
# 5. Runtime Uploads & Generated Media
# ------------------------------------------------------------------------------
uploads/
backend/uploads/
backend/app/uploads/
*.tmp
*.temp

# ------------------------------------------------------------------------------
# 6. Operating System Files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# ------------------------------------------------------------------------------
# 7. Editors & IDEs
# ------------------------------------------------------------------------------
.idea/
.vscode/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln
